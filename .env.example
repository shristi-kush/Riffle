# Copy to .env and adjust as needed. Compose already sets Docker-safe defaults.

# --- LLM (Ollama, OpenAI-compatible) ----------------------------------------
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_API_KEY=not-needed
LLAMA_MODEL=qwen2.5:3b
# Judge model for RAGAS evaluation (larger = more reliable). Defaults to LLAMA_MODEL.
EVAL_LLM_MODEL=qwen2.5:3b
# Generation cap (tokens). Lower = faster. 512 is enough for concise RAG answers.
LLM_MAX_TOKENS=512
# Ollama context window. Qwen defaults to 32k; 8192 is plenty for 4 chunks + history
# and makes prefill much faster.
LLM_NUM_CTX=8192
# Keep the model loaded in Ollama. -1 = never unload.
LLM_KEEP_ALIVE=-1

# --- Embeddings / chunking --------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# auto | cpu | cuda. auto uses CUDA when available.
EMBEDDING_DEVICE=auto
CHUNKING_STRATEGY=semantic   # semantic | recursive

# --- Retrieval / reranking --------------------------------------------------
RETRIEVER_K=4
RETRIEVE_TOP_N=12
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5
RERANK_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Voice (Phase 3) --------------------------------------------------------
STT_MODEL_SIZE=base          # tiny | base | small | medium | large-v3
STT_BEAM_SIZE=1              # 1 is fastest; raise for slightly better transcripts
TTS_VOICE=en_US-lessac-medium

# --- Agent tools (Phase 4) --------------------------------------------------
# Optional: web search is auto-disabled when this is empty.
TAVILY_API_KEY=
# Prior chat turns sent with each question so follow-ups like "in it" work.
AGENT_HISTORY_TURNS=6

# --- LangSmith tracing (optional) -------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=riffle
